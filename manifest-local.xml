<?xml version="1.0" encoding="UTF-8"?>
<!--
  Standpoint.Bio — the Word task pane. THE REAL MANIFEST.

  Loads the pane from the app itself: Standpoint serves these files over TLS on
  https://127.0.0.1:8443/addin/, and answers the pane's requests from that same
  address. Same origin for both, which is the whole design.

  WHY, measured on Mac Word: a pane served from a public HTTPS address cannot
  reach this machine. Plaintext is refused in 2-5 ms, and a secure call from a
  hosted pane failed too (45 ms), while the identical call from an app-served
  pane answered in 19 ms. manifest.xml, the hosted sibling, is kept only for the
  browser control experiment; it does not work in Word.

  Same origin also removed the security machinery the old plan had: no pairing
  code and no token, because the pane is not a stranger. It is what let the
  backend drop allow_origins=["*"], which until then let any website the
  scientist visited read their whole library.

  Permissions is ReadDocument, the lowest level that can read a selection: the
  pane cannot write to the document, and Word enforces that rather than the code
  promising it.

  THE CERTIFICATE MUST BE TRUSTED FIRST. Standpoint generates it per machine
  into its data dir (services/addin_server.py); the private key never leaves the
  machine and is never shipped. An untrusted certificate produces NO error
  message anywhere — the pane is simply blank. See README.md for the one
  command, and Phase 5 for the button that will replace it.
-->
<OfficeApp
    xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
    xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
    xsi:type="TaskPaneApp">

  <Id>00CB1E47-4421-4C8A-9AA7-0D8C9066B138</Id>
  <Version>0.1.0.0</Version>
  <ProviderName>Standpoint.Bio</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Standpoint (local)"/>
  <Description DefaultValue="Connection and selection-event diagnostic for the Standpoint.Bio Word add-in."/>
  <IconUrl DefaultValue="https://127.0.0.1:8443/addin/assets/icon-64.png"/>
  <HighResolutionIconUrl DefaultValue="https://127.0.0.1:8443/addin/assets/icon-80.png"/>
  <SupportUrl DefaultValue="https://github.com/agpranaybio/standpoint-addin"/>

  <Hosts>
    <Host Name="Document"/>
  </Hosts>

  <DefaultSettings>
    <SourceLocation DefaultValue="https://127.0.0.1:8443/addin/taskpane.html"/>
  </DefaultSettings>

  <Permissions>ReadDocument</Permissions>

  <!--
    VersionOverrides adds the ribbon button. Without it the add-in still loads
    (older hosts fall back to DefaultSettings above), so this is additive: if a
    host rejects the overrides it degrades to a working pane rather than to
    nothing.
  -->
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Document">
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="GetStarted.Title"/>
            <Description resid="GetStarted.Description"/>
            <LearnMoreUrl resid="GetStarted.LearnMoreUrl"/>
          </GetStarted>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="Standpoint.Group">
                <Label resid="Group.Label"/>
                <Icon>
                  <bt:Image size="16" resid="Icon.16"/>
                  <bt:Image size="32" resid="Icon.32"/>
                  <bt:Image size="80" resid="Icon.80"/>
                </Icon>
                <Control xsi:type="Button" id="Standpoint.TaskpaneButton">
                  <Label resid="Button.Label"/>
                  <Supertip>
                    <Title resid="Button.Label"/>
                    <Description resid="Button.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16"/>
                    <bt:Image size="32" resid="Icon.32"/>
                    <bt:Image size="80" resid="Icon.80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>Standpoint.Taskpane</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>

    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16" DefaultValue="https://127.0.0.1:8443/addin/assets/icon-16.png"/>
        <bt:Image id="Icon.32" DefaultValue="https://127.0.0.1:8443/addin/assets/icon-32.png"/>
        <bt:Image id="Icon.80" DefaultValue="https://127.0.0.1:8443/addin/assets/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Taskpane.Url" DefaultValue="https://127.0.0.1:8443/addin/taskpane.html"/>
        <bt:Url id="GetStarted.LearnMoreUrl" DefaultValue="https://github.com/agpranaybio/standpoint-addin"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="Group.Label" DefaultValue="Standpoint"/>
        <bt:String id="Button.Label" DefaultValue="Local"/>
        <bt:String id="GetStarted.Title" DefaultValue="Standpoint connection check"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="Button.Tooltip" DefaultValue="Check whether this pane can reach Standpoint on this machine, and whether selection events fire while you type."/>
        <bt:String id="GetStarted.Description" DefaultValue="Open the Standpoint pane from the Home tab, with Standpoint.Bio running on this machine."/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
